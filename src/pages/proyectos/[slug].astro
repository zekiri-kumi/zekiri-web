---
import Layout from "../../layouts/main.astro";
import ProyectosApp from "@/components/proyectos/ProyectosApp";
import { publishedArticles } from "@/lib/blog";
import { IS_BLOG_LISTED } from "@/lib/blog-paths";
import { SITE_URL } from "@/lib/seo";
import { projectForPage } from "@/lib/proyectos-content";

// Server-rendered like the rest of the site: prerendered folders made Netlify add a trailing-slash redirect.
export const prerender = false;

const project = projectForPage(Astro.params.slug ?? "");
if (!project) return Astro.rewrite("/404");

const canonicalPath = `/proyectos/${project.slug}`;

// While the blog is unlisted, case pages do not point to it.
const articles = IS_BLOG_LISTED
  ? (await publishedArticles())
      .filter((entry) => entry.data.project === project.slug)
      .map((entry) => ({ slug: entry.id, title: entry.data.title }))
  : [];

const content = {
  title: `${project.sector}: caso de software a medida | Zékiri`,
  description: project.headline,
  language: "es",
  canonicalPath,
  ogImage: SITE_URL + project.screens[0].src,
  noindex: project.unlisted === true,
  breadcrumbItems: [
    { name: "Inicio", url: SITE_URL + "/" },
    { name: "Proyectos", url: SITE_URL + "/proyectos" },
    { name: project.sector, url: SITE_URL + canonicalPath },
  ],
};
---

<Layout content={content}>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600&display=swap"
    rel="stylesheet"
  />
  <ProyectosApp client:load slug={project.slug} articles={articles} />
</Layout>
